<?xml version="1.0" encoding="UTF-8"?>
<CPackWiXPatch>
    <CPackWiXFragment Id="CM_CP_AWARP.AWARP_service.exe">
        <ServiceInstall
                Id="AwarpServiceInstall"
                Name="AWARP-service"
                DisplayName="AWARP Service"
                Description="Service for AWARP"
                Start="auto"
                Type="ownProcess"
                ErrorControl="normal"
                Vital="no">
            <ServiceDependency Id="BFE" />
            <ServiceDependency Id="nsi" />
        </ServiceInstall>
        <ServiceControl
                Id="AwarpServiceControl"
                Name="AWARP-service"
                Start="install"
                Stop="both"
                Remove="uninstall"
                Wait="yes" />
    </CPackWiXFragment>
</CPackWiXPatch>
